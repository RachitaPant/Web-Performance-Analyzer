# Firebase (client SDK — these are public by design; protect data with Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google PageSpeed Insights API key (server-only). Create one at
# https://console.cloud.google.com → APIs & Services → enable "PageSpeed Insights API" → Credentials.
GOOGLE_PAGESPEED_API_KEY=

# Recommended in production: a SECOND Google key used by the browser to run PageSpeed directly,
# so heavy pages (100 s+ on PSI) aren't cut off by serverless time limits. It ships in the JS
# bundle, so in Google Cloud restrict it to HTTP referrers on your domain (e.g.
# https://your-app.vercel.app/*) and to the PageSpeed Insights API only. Unset = server-side PSI.
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing it.
NEXT_PUBLIC_PSI_BROWSER_KEY=

# Optional: separate key for the Chrome UX Report API (CrUX history trends).
# Defaults to GOOGLE_PAGESPEED_API_KEY — that key must have "Chrome UX Report API" enabled and allowed.
CRUX_API_KEY=

# Optional: Upstash Redis (free tier) for a shared report cache + rate limit across serverless
# instances. Without these, both fall back to per-instance memory. Vercel's Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN instead, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: AI insights and "Ask about this report". Any OpenAI-compatible provider works.
#   AI_PROVIDER: groq (default, free tier) | openrouter | gemini | openai | ollama | custom
#   AI_MODEL: required except for groq (defaults to openai/gpt-oss-120b, falls back to openai/gpt-oss-20b)
#   AI_BASE_URL: required for custom; overrides the preset endpoint otherwise
# Without these the app works normally and the AI cards explain that AI isn't configured.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_FALLBACK_MODELS=
