# Firebase (client SDK — these are public by design; protect data with Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google PageSpeed Insights API key (server-only). Create one at
# https://console.cloud.google.com → APIs & Services → enable "PageSpeed Insights API" → Credentials.
GOOGLE_PAGESPEED_API_KEY=

# Optional: separate key for the Chrome UX Report API (CrUX history trends).
# Defaults to GOOGLE_PAGESPEED_API_KEY — that key must have "Chrome UX Report API" enabled and allowed.
CRUX_API_KEY=

# Optional: Upstash Redis (free tier) for a shared report cache + rate limit across serverless
# instances. Without these, both fall back to per-instance memory. Vercel's Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN instead, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
